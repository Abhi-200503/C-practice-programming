#include <stdio.h>

int reverseNumber(int n, int rev)
{
    if (n == 0)
        return rev;

    return reverseNumber(n / 10, rev * 10 + n % 10);
}

int main()
{
    int n, reverse;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

    reverse = reverseNumber(n, 0);

    printf("Reverse = %d", reverse);

    return 0;
}


Output 
Enter a positive integer: 12345
Reverse = 54321
