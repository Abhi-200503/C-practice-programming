#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int freq[256] = {0};
    int i, found = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    // Count frequency
    for (i = 0; str[i] != '\0'; i++)
    {
        freq[(unsigned char)str[i]]++;
    }

    // Find first character with frequency 1
    for (i = 0; str[i] != '\0'; i++)
    {
        if (freq[(unsigned char)str[i]] == 1)
        {
            printf("First Non-Repeating Character: %c", str[i]);
            found = 1;
            break;
        }
    }

    if (found == 0)
        printf("-1");

    return 0;
}

